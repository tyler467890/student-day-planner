  "rules": [
    {
      "id": "school-no-study",
      "trigger": "missing",
      "description": "Has school/class goals but nothing about studying or homework.",
      "when": {
        "anyOf": [
          "school",
          "exam"
        ],
        "noneOf": [
          "study",
          "homework"
        ]
      },
      "suggest": [
        "study"
      ],
      "priority": 90,
      "preferIds": [
        "stu-05",
        "stu-01",
        "stu-09"
      ]
    },
    {
      "id": "exam-coming",
      "trigger": "present",
      "description": "Has an exam/test goal: suggest proven study methods and protecting sleep.",
      "when": {
        "anyOf": [
          "exam"
        ],
        "noneOf": [
          "study"
        ]
      },
      "suggest": [
        "study",
        "sleep"
      ],
      "priority": 88,
      "preferIds": [
        "stu-02",
        "stu-03",
        "slp-09"
      ]
    },
    {
      "id": "late-night",
      "trigger": "present",
      "description": "Goal names mention late night/staying up, or a goal is scheduled after 22:30.",
      "when": {
        "anyOf": [
          "lateNight"
        ],
        "orGoalTimeAfter": "22:30"
      },
      "suggest": [
        "sleep"
      ],
      "priority": 86,
      "preferIds": [
        "slp-01",
        "slp-10",
        "slp-09"
      ]
    },
    {
      "id": "work-heavy-no-rest",
      "trigger": "tooMuch",
      "description": "Lots of work/job/shift goals and nothing restful.",
      "when": {
        "anyOf": [
          "work",
          "chores"
        ],
        "minMatches": 3,
        "minShare": 0.4,
        "noneOf": [
          "rest"
        ]
      },
      "suggest": [
        "relax",
        "wellbeing"
      ],
      "priority": 85,
      "preferIds": [
        "rlx-01",
        "rlx-10",
        "wel-13"
      ]
    },
    {
      "id": "stress-words",
      "trigger": "present",
      "description": "Goal names mention stress, worry, being overwhelmed or rushed, with no wellbeing goal.",
      "when": {
        "anyOf": [
          "stress"
        ],
        "noneOf": [
          "wellbeing"
        ]
      },
      "suggest": [
        "wellbeing",
        "relax"
      ],
      "priority": 84,
      "preferIds": [
        "wel-02",
        "wel-03",
        "wel-07"
      ]
    },
    {
