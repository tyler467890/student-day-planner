{
  "version": 1,
  "settings": {
    "maxPerDay": 1,
    "maxPerWeek": 2,
    "showChanceWhenEligible": 0.3,
    "minDaysBetweenSuggestions": 3,
    "cooldownAfterDismissDays": 7,
    "cooldownAfterAcceptDays": 3,
    "neverRepeatDismissedIds": true,
    "categorySnoozeAfterDismissals": {
      "count": 3,
      "withinDays": 30,
      "snoozeDays": 30
    },
    "doNotResuggestAcceptedWhileGoalExists": true,
    "resuggestAcceptedAfterDays": 90,
    "minDaysSinceFirstUse": 2,
    "minGoalsBeforeGapRules": 3,
    "quietHours": {
      "start": "21:00",
      "end": "07:00"
    },
    "showOnlyAtAppOpen": true,
    "avoidWhenAllTodayGoalsDone": false,
    "skipIfOpenGoalsAtLeast": 12,
    "ageSafeOnlyByDefault": true,
    "fallbackWhenNoRuleFires": "random-category-easy",
    "rulePickStrategy": "weighted-random-by-priority",
    "difficultyPoints": "use the app's existing Easy/Medium/Hard points"
  },
  "matching": {
    "normalize": [
      "lowercase",
      "strip emoji and punctuation except '-' and apostrophes in words",
      "collapse whitespace",
      "replace '&' with 'and'"
    ],
    "tokenMatch": "single-word synonyms match whole tokens, also after stripping a trailing 's', 'es', 'ing' or 'ed' from the token",
    "phraseMatch": "multi-word synonyms match as whole-word substrings of the normalized goal name",
    "shortWords": "synonyms of 3 letters or fewer (e.g. 'hw', 'pe', 'tv', 'sat', 'act') must match a whole token exactly, never a substring",
    "multiConcept": "one goal can match several concepts (e.g. 'gym after work' -> fitness + work)",
    "scope": "evaluate open goals plus goals completed in the last 7 days; include recurring goals once each"
  },
